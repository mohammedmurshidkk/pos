{
  "name": "@pos/desktop",
  "version": "0.3.0",
  "productName": "Al Manzil POS",
  "private": true,
  "main": "dist/main.cjs",
  "scripts": {
    "build:main": "esbuild src/main.ts --bundle --platform=node --format=cjs --outfile=dist/main.cjs --external:electron --external:better-sqlite3 --external:pino-pretty",
    "build:ui": "pnpm --filter @pos/admin build",
    "build": "pnpm build:ui && pnpm build:main && node scripts/copy-assets.mjs",
    "start": "pnpm native:electron && pnpm build && electron .",
    "pack": "pnpm build && electron-builder --dir",
    "dist:win": "pnpm native:win && pnpm build && electron-builder --win --publish never",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "native:win": "node scripts/native.mjs win32",
    "native:electron": "node scripts/native.mjs electron",
    "native:node": "node scripts/native.mjs node"
  },
  "dependencies": {
    "better-sqlite3": "^11.5.0"
  },
  "devDependencies": {
    "@pos/server": "workspace:*",
    "@types/node": "^22.9.0",
    "electron": "33.4.11",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "build": {
    "appId": "com.almanzil.pos",
    "productName": "Al Manzil POS",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "AlManzilPOS-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "include": "installer/installer.nsh"
    },
    "mac": {
      "target": [
        "dir"
      ]
    },
    "npmRebuild": false,
    "electronVersion": "33.4.11"
  },
  "description": "Restaurant POS hub \u2014 server, cashier UI and printing in one app",
  "author": "Al Manzil POS"
}