{
  "name": "@pos/desktop",
  "version": "0.4.2",
  "private": true,
  "main": "dist/main.cjs",
  "scripts": {
    "build:main": "esbuild src/main.ts --bundle --platform=node --format=cjs --outfile=dist/main.cjs --external:electron --external:better-sqlite3 --external:pino-pretty && esbuild src/preload.ts --bundle --platform=node --format=cjs --outfile=dist/preload.cjs --external:electron",
    "build:ui": "pnpm --filter @pos/admin build",
    "build": "pnpm build:ui && pnpm build:main && node scripts/copy-assets.mjs",
    "start": "pnpm native:electron && pnpm build && electron .",
    "pack": "pnpm build && electron-builder --dir",
    "dist:win": "pnpm native:win && pnpm build && electron-builder --win --publish never",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "native:win": "node scripts/native.mjs win32",
    "native:electron": "node scripts/native.mjs electron",
    "native:node": "node scripts/native.mjs node"
  },
  "dependencies": {
    "better-sqlite3": "^11.5.0"
  },
  "devDependencies": {
    "@pos/server": "workspace:*",
    "@types/node": "^22.9.0",
    "electron": "33.4.11",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "description": "Restaurant POS hub — server, cashier UI and printing in one app"
}
